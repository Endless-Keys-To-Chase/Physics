import numpy as np
import matplotlib.pyplot as plt

T1 = np.array([5,10,15,20,25])
K1 = np.array([np.pi,np.pi,np.pi,np.pi,np.pi])
K2 = np.array([np.pi*3,np.pi*3,np.pi*3,np.pi*3,np.pi*3])
T2a = np.array([25,35,45,55,65])
T2b = np.array([28.8,33.8,43.8,55.6,61.8])
T2c = np.array([28.2,36.7,46,54,64])
T2_a = np.array([105,110.5,136,149,164])
T2_b = np.array([95,100,114,125,135])
T2_c = np.array([87,106,124,136,148])
plt.scatter(K1,np.log(T2a/T1),color = 'red')
plt.scatter(K1,np.log(T2b/T1),color = 'blue')
plt.scatter(K1,np.log(T2c/T1),color = 'magenta')
plt.scatter(K2,np.log(T2_a/T1),color = 'red')
plt.scatter(K2,np.log(T2_b/T1),color = 'blue')
plt.scatter(K2,np.log(T2_c/T1),color = 'magenta')
TH = np.concatenate([K1,K1,K1,K2,K2,K2])
P2 = np.concatenate([T2a,T2b,T2c,T2_a,T2_b,T2_c])
P1 = np.concatenate([T1,T1,T1,T1,T1,T1])
slope , intercept= np.polyfit(TH,np.log(P2/P1),1)
trendline = slope*TH + intercept
plt.plot(TH,trendline, color ='green')

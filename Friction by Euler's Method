#trendline = slope*TH + intercept,plt.plot(TH,trendline, color ='blue')
plt.title("log(T2/T1) vs θ Scatter Plot with best fit Trendline")
plt.xlabel("θ (π = 3.14)")
plt.ylabel("log(T2/T1)")
